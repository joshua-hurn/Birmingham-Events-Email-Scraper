# ============================================================================
# 1. Gemini API Configuration (Required for live event scraping & curation)
# ============================================================================
# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# How many days ahead to search for Birmingham events
EVENT_CITY=Birmingham, AL
LOOKAHEAD_DAYS=30

# ============================================================================
# 2. Proton Mail Bridge (Local SMTP) or Custom SMTP Settings
# ============================================================================
# Proton Mail Bridge defaults to 127.0.0.1 on port 1025 with STARTTLS.
# Open Proton Mail Bridge -> click your account -> Mailbox details to copy the
# Bridge hostname, port, username, and Bridge password (NOT your main Proton login password).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=your_email@proton.me
SMTP_PASSWORD=your_proton_bridge_password
SMTP_STARTTLS=true
SMTP_SSL=false
# Proton Mail Bridge uses a local self-signed TLS certificate by default:
SMTP_VERIFY_CERT=false

EMAIL_FROM=your_email@proton.me
EMAIL_TO=your_email@proton.me

# ============================================================================
# 3. Optional: Hosted Proton Calendar .ics Subscription URL
# ============================================================================
# If you publish `output/birmingham_events.ics` via GitHub Actions / GitHub Pages
# or a public Gist, paste the raw URL here so it appears in your email digest header
# and auto-syncs into Proton Calendar -> "Add calendar from URL".
PROTON_ICS_FEED_URL=
